{
  "name": "fast-tech-whatsapp-manager",
  "version": "1.0.7",
  "description": "Fast Tech WhatsApp Business Manager - Professional WhatsApp Business Management System",
  "main": "src/main/index.js",
  "author": "Fast Tech",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "set ELECTRON_RUN_AS_NODE=&& electron .",
    "dev": "set ELECTRON_RUN_AS_NODE=&& electron . --dev",
    "build": "npm run obfuscate && electron-builder --win",
    "build:portable": "npm run obfuscate && electron-builder --win portable",
    "build:dev": "electron-builder --win",
    "install-deps": "npm install",
    "generate-icon": "node scripts/generate-icon.js",
    "postinstall": "electron-builder install-app-deps",
    "obfuscate": "javascript-obfuscator src/main --output src/main-obfuscated --compact true --self-defending true --identifier-names-generator mangled --string-array true --string-array-encoding rc4 --string-array-threshold 0.75 --dead-code-injection false"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.9",
    "@google/generative-ai": "^0.3.1",
    "axios": "^1.6.5",
    "better-sqlite3": "^9.4.3",
    "electron-updater": "^6.8.3",
    "form-data": "^4.0.0",
    "libphonenumber-js": "^1.10.58",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "puppeteer": "^21.11.0",
    "qrcode": "^1.5.4",
    "uuid": "^9.0.0",
    "whatsapp-web.js": "^1.34.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3",
    "javascript-obfuscator": "^4.2.2",
    "jimp": "^1.6.1",
    "to-ico": "^1.1.5"
  },
  "build": {
    "appId": "com.fasttech.whatsapp-cyber-nexus",
    "productName": "FAST TECH WhatsApp Cyber Nexus",
    "copyright": "Copyright © 2024 Fast Tech. All Rights Reserved.",
    "icon": "assets/icon.ico",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "requireAdministrator",
      "sign": null,
      "certificateSubjectName": null,
      "signingHashAlgorithms": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FAST TECH WA Nexus",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "displayLanguageSelector": false
    },
    "afterPack": "scripts/inject-wm-slot-hook.js",
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/puppeteer/**",
      "node_modules/puppeteer-core/**",
      "node_modules/whatsapp-web.js/**",
      "node_modules/better-sqlite3/**"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist-new"
    },
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "publish": [
      {
        "provider":     "github",
        "owner":        "ehabalqadi001-lang",
        "repo":         "fast-tech-wa-releases",
        "private":      true,
        "releaseType":  "release"
      }
    ]
  }
}
